{
  "name": "hashi",
  "version": "1.0.0",
  "description": "数桥 HASHI — 浏览器原生 Hashiwokakero. 解数=1 由穷举计数器证明, 推理深度由规则求解器量出, Σp 与桥数由握手引理对账.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.cjs",
    "dev": "node server.cjs 5181",
    "electron": "electron .",
    "bake": "node tools/bake.mjs",
    "balance": "node test/balance.mjs",
    "check": "for f in js/*.js js/*/*.js server.cjs electron/main.cjs tools/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done && echo OK",
    "unit": "for f in test/*.test.mjs; do node \"$f\" || exit 1; done",
    "doctest": "node tools/doctest.mjs",
    "sabotage": "node tools/sabotage.mjs",
    "test": "npm run check && npm run unit",
    "verify": "bash tools/verify.sh",
    "deploy-set": "node tools/deploy-set.mjs",
    "deploy-set:selftest": "node tools/deploy-set-selftest.mjs"
  },
  "keywords": [
    "game",
    "puzzle",
    "hashi",
    "hashiwokakero",
    "bridges",
    "logic",
    "electron"
  ],
  "author": "z-biz-game",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {},
  "build": {
    "appId": "com.zbiz.hashi",
    "productName": "Hashi",
    "mac": {
      "category": "public.app-category.puzzle-games"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
